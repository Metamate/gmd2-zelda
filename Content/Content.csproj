<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The content builder: a small console app that builds the files in Assets/ into the
    format the game loads at runtime. The rules for what to build and how are C# code in
    Builder/Builder.cs. Game projects run it automatically through BuildContent.targets.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BuildContent.targets runs the builder from bin\Debug\Content. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- MonoGame's pipeline package pulls in old packages that trigger warnings NU1903 and
         NETSDK1206. The builder never ships with the game, so we hide them. -->
    <NoWarn>$(NoWarn);NU1903;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.*" />
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.*" PrivateAssets="All" />
    <!-- FFmpeg converts audio. Referenced directly so its programs are copied next to the builder. -->
    <PackageReference Include="MonoGame.Tool.FFmpeg" Version="7.0.0.*" />
    <PackageReference Include="MonoGame.Tool.FFprobe" Version="7.0.0.*" />
  </ItemGroup>

</Project>
